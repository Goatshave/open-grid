    },
    {
      "directory": "vue",
      "name": "@open-grid/vue",
      "exports": {
        ".": {
          "import": "./dist/index.js",
          "types": "./dist/index.d.ts"
        }
      }
    },
    {
      "directory": "vue-ui",
      "name": "@open-grid/vue-ui",
      "exports": {
        ".": {
          "import": "./dist/index.js",
          "types": "./dist/index.d.ts"
        },
        "./css": "./dist/index.css"
      }
    }
