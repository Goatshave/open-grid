{
  "name": "@open-grid/virtual",
  "version": "0.1.0",
  "description": "Framework-agnostic virtualization primitives for Open Grid.",
  "keywords": ["data-grid", "grid", "table", "virtualization", "typescript"],
  "homepage": "https://goatshave.github.io/open-grid/packages#virtual",
  "bugs": {
    "url": "https://github.com/Goatshave/open-grid/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
