{
  "name": "open-grid-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "MIT open-source, multi-framework data grid foundation.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build": "pnpm -r --filter './packages/*' build",
    "api:check": "node scripts/api-contract.mjs",
    "api:update": "node scripts/api-contract.mjs --write",
    "check": "pnpm -r --filter './packages/*' --filter @open-grid/example-shared-server check",
    "test": "pnpm test:release && pnpm benchmark:test && pnpm -r --filter './packages/*' --filter @open-grid/example-shared-server test",
    "test:release": "node --test scripts/test/*.test.mjs",
    "benchmark:test": "node --test benchmarks/shared/test/*.test.mjs",
    "benchmark:build": "pnpm benchmark:bundle:build",
    "benchmark:bundle:build": "pnpm build && pnpm --filter @open-grid/benchmark-open-grid-react build && pnpm --filter @open-grid/benchmark-open-grid-react-full build && pnpm --filter @open-grid/benchmark-open-grid-vue build && pnpm --filter @open-grid/benchmark-open-grid-svelte build",
    "benchmark:bundle:check": "node scripts/benchmark-bundle-budget.mjs",
    "benchmark:bundle:run": "pnpm benchmark:bundle:build && pnpm benchmark:bundle:check",
    "benchmark:structure:e2e": "playwright test --config playwright.structure-benchmark.config.ts",
    "benchmark:structure:run": "pnpm benchmark:bundle:build && pnpm benchmark:structure:e2e",
    "benchmark:e2e": "pnpm benchmark:framework:e2e",
    "benchmark:measure": "node scripts/benchmark-runner.mjs --suite framework",
    "benchmark:run": "pnpm benchmark:build && pnpm benchmark:measure",
    "benchmark:core-filter:measure": "node scripts/core-filter-benchmark.mjs",
    "benchmark:core-filter:run": "pnpm --filter @open-grid/core build && pnpm benchmark:core-filter:measure",
    "benchmark:core-filter:massive:measure": "node scripts/core-filter-benchmark.mjs --profiles stress-client,massive-virtual --runs 20 --warmups 2 --json-out .benchmark-results/core-filter/massive.json --markdown-out .benchmark-results/core-filter/massive.md",
    "benchmark:core-filter:massive:check": "node scripts/benchmark-core-compute-budget.mjs",
    "benchmark:core-filter:massive:run": "pnpm --filter @open-grid/core build && pnpm benchmark:core-filter:massive:measure && pnpm benchmark:core-filter:massive:check",
    "benchmark:matrix": "node scripts/benchmark-runner.mjs --profiles all --json-out .benchmark-results/matrix/latest.json --markdown-out .benchmark-results/matrix/latest.md",
    "benchmark:matrix:run": "pnpm benchmark:build && pnpm benchmark:matrix",
    "benchmark:baseline:measure": "node scripts/benchmark-runner.mjs --suite framework --profiles all --runs 12 --warmups 2 --checkpoint-dir .benchmark-results/baseline/checkpoints --json-out .benchmark-results/baseline/open-grid.json --markdown-out .benchmark-results/baseline/open-grid.md",
    "benchmark:baseline:resume": "pnpm benchmark:build && node scripts/benchmark-runner.mjs --suite framework --profiles all --runs 12 --warmups 2 --checkpoint-dir .benchmark-results/baseline/checkpoints --resume --json-out .benchmark-results/baseline/open-grid.json --markdown-out .benchmark-results/baseline/open-grid.md",
    "benchmark:baseline:run": "pnpm benchmark:build && pnpm benchmark:baseline:measure",
    "benchmark:framework:build": "pnpm build && pnpm --filter @open-grid/benchmark-open-grid-react-full build && pnpm --filter @open-grid/benchmark-open-grid-vue build && pnpm --filter @open-grid/benchmark-open-grid-svelte build",
    "benchmark:framework:e2e": "pnpm benchmark:framework:build && playwright test --config playwright.framework-benchmark.config.ts",
    "benchmark:framework:measure": "node scripts/benchmark-runner.mjs --suite framework --json-out .benchmark-results/framework/latest.json --markdown-out .benchmark-results/framework/latest.md",
    "benchmark:framework:run": "pnpm benchmark:framework:build && pnpm benchmark:framework:measure",
    "benchmark:framework:heap:measure": "node scripts/framework-heap-profile.mjs",
    "benchmark:framework:heap:run": "pnpm benchmark:framework:build && pnpm benchmark:framework:heap:measure",
    "benchmark:framework:heap:budget:measure": "node scripts/framework-heap-profile.mjs --profile standard-client --phase settled-workload --retainer-groups 0 --json-out .benchmark-results/framework/heap/ci-budget.json --markdown-out .benchmark-results/framework/heap/ci-budget.md",
    "benchmark:framework:heap:budget:check": "node scripts/benchmark-heap-budget.mjs",
    "benchmark:framework:heap:budget:run": "pnpm benchmark:framework:build && pnpm benchmark:framework:heap:budget:measure && pnpm benchmark:framework:heap:budget:check",
    "benchmark:server:build": "pnpm build && pnpm --filter @open-grid/benchmark-open-grid-react-server build",
    "benchmark:server:e2e": "pnpm benchmark:server:build && playwright test --config playwright.server-benchmark.config.ts",
    "benchmark:server:measure": "node scripts/server-benchmark-runner.mjs",
    "benchmark:server:run": "pnpm benchmark:server:build && pnpm benchmark:server:measure",
    "benchmark:server:budget:measure": "node scripts/server-benchmark-runner.mjs --profile standard-client --runs 10 --warmups 2 --json-out .benchmark-results/server/ci-budget.json --markdown-out .benchmark-results/server/ci-budget.md && node scripts/server-benchmark-runner.mjs --profile stress-client --runs 10 --warmups 2 --json-out .benchmark-results/server/stress-ci-budget.json --markdown-out .benchmark-results/server/stress-ci-budget.md",
    "benchmark:server:budget:check": "node scripts/benchmark-server-budget.mjs && node scripts/benchmark-server-budget.mjs --config benchmarks/server-stress-budgets.json --input .benchmark-results/server/stress-ci-budget.json",
    "benchmark:server:budget:run": "pnpm benchmark:server:build && pnpm benchmark:server:budget:measure && pnpm benchmark:server:budget:check",
    "benchmark:dev:open-grid": "pnpm --filter @open-grid/benchmark-open-grid-react dev",
    "lint": "pnpm -r --filter './packages/*' lint",
    "release:check": "node scripts/release-check.mjs",
    "release:consumer-smoke": "node scripts/release-consumer-smoke.mjs",
    "release:first-publish-next-step": "node scripts/release-first-publish-status.mjs --next-step",
    "release:first-publish-preflight": "node scripts/release-first-publish-preflight.mjs",
    "release:first-publish-status": "node scripts/release-first-publish-status.mjs",
    "release:github-push-preflight": "node scripts/release-github-push-preflight.mjs",
    "release:plan": "node scripts/release-plan.mjs",
    "release:policy": "node scripts/release-policy.mjs",
    "release:publish": "node scripts/release-publish.mjs",
    "release:publish-dry-run": "node scripts/release-publish-dry-run.mjs",
    "release:stage": "node scripts/release-stage.mjs",
    "release:trusted-publishing": "node scripts/release-trusted-publishing.mjs",
    "release:ui-smoke-report-check": "node scripts/ui-smoke-report-check.mjs",
    "review:smoke-ui": "node scripts/ui-smoke-review.mjs",
    "dev:react": "pnpm --filter @open-grid/example-react-basic dev",
    "dev:server": "pnpm --filter @open-grid/example-react-server-side dev",
    "dev:server-grouping": "pnpm --filter @open-grid/example-react-server-grouping dev",
    "dev:server-tree": "pnpm --filter @open-grid/example-react-server-tree dev",
    "dev:vue": "pnpm --filter @open-grid/example-vue-grouped dev",
    "dev:vue-server": "pnpm --filter @open-grid/example-vue-server-side dev",
    "dev:vue-server-tree": "pnpm --filter @open-grid/example-vue-server-tree dev",
    "dev:svelte": "pnpm --filter @open-grid/example-svelte-grouped dev",
    "dev:svelte-server": "pnpm --filter @open-grid/example-svelte-server-side dev",
    "dev:svelte-server-tree": "pnpm --filter @open-grid/example-svelte-server-tree dev",
    "dev:nextjs": "pnpm --filter @open-grid/example-nextjs-server-export dev",
    "dev:nuxt": "pnpm --filter @open-grid/example-nuxt-server-export dev",
    "dev:sveltekit": "pnpm --filter @open-grid/example-sveltekit-server-export dev",
    "preview:smoke-ui": "node scripts/ui-smoke-preview.mjs",
    "build:examples": "pnpm -r --filter './examples/*' build",
    "compatibility:check": "pnpm -r --filter './compatibility/*' build",
    "e2e": "pnpm build && playwright test",
    "e2e:renderers": "pnpm build && playwright test --config playwright.renderers.config.ts",
    "e2e:smoke": "pnpm build && playwright test --config playwright.smoke.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.8"
  }
}
