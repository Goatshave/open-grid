{
  "name": "@open-grid/example-shared-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./framework-app-examples/nextjs/app/tickets/page": {
      "types": "./src/framework-app-examples/nextjs/app/tickets/page.ts",
      "import": "./src/framework-app-examples/nextjs/app/tickets/page.ts"
    },
    "./framework-app-examples/nextjs/app/api/tickets/export/route": {
      "types": "./src/framework-app-examples/nextjs/app/api/tickets/export/route.ts",
