    },
    "./framework-app-examples/nuxt/pages/tickets": {
      "types": "./src/framework-app-examples/nuxt/pages/tickets.ts",
      "import": "./src/framework-app-examples/nuxt/pages/tickets.ts"
    },
    "./framework-app-examples/nuxt/server/api/tickets/export.get": {
